{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/vendor-onboarding.json",
  "title": "Vendor Onboarding",
  "description": "JSON Schema for Vendor Onboarding Stepper form data, onboarding state, user log, and export payload.",
  "definitions": {
    "DocumentItem": {
      "type": "object",
      "description": "Serializable document metadata (file binary not stored in JSON).",
      "required": ["id", "type", "name", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "examples": ["contract", "taxCertificate", "insurance"] },
        "name": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "uploaded", "error"]
        }
      },
      "additionalProperties": false
    },
    "VendorOnboardingFormData": {
      "type": "object",
      "description": "Full form data for the 4-step wizard.",
      "required": [
        "companyName", "registrationNumber", "taxId",
        "contactName", "email", "phone", "jobTitle",
        "addressLine1", "addressLine2", "city", "state", "postalCode",
        "riskCategory", "industry", "riskNotes", "requiresAudit", "complianceNotes",
        "documents"
      ],
      "properties": {
        "companyName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "taxId": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "jobTitle": { "type": "string" },
        "addressLine1": { "type": "string" },
        "addressLine2": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postalCode": { "type": "string" },
        "riskCategory": { "type": "string" },
        "industry": { "type": "string" },
        "riskNotes": { "type": "string" },
        "requiresAudit": { "type": "boolean" },
        "complianceNotes": { "type": "string" },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/definitions/DocumentItem" }
        }
      },
      "additionalProperties": false
    },
    "UserLogAction": {
      "type": "string",
      "enum": ["step_enter", "draft_saved", "submitted"]
    },
    "UserLogEntry": {
      "type": "object",
      "description": "Single entry in the user activity log.",
      "required": ["id", "timestamp", "action"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "action": { "$ref": "#/definitions/UserLogAction" },
        "step": { "type": "integer", "minimum": 0, "maximum": 3 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "OnboardingState": {
      "type": "object",
      "description": "State persisted to localStorage on Save draft or Submit.",
      "required": ["formData", "currentStep", "log"],
      "properties": {
        "formData": { "$ref": "#/definitions/VendorOnboardingFormData" },
        "currentStep": { "type": "integer", "minimum": 0, "maximum": 3 },
        "log": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserLogEntry" }
        }
      },
      "additionalProperties": false
    },
    "ExportPayload": {
      "type": "object",
      "description": "Payload of the exported JSON file after submit.",
      "required": ["formData", "submittedAt"],
      "properties": {
        "formData": { "$ref": "#/definitions/VendorOnboardingFormData" },
        "userLog": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserLogEntry" }
        },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/VendorOnboardingFormData" },
    { "$ref": "#/definitions/OnboardingState" },
    { "$ref": "#/definitions/ExportPayload" }
  ]
}
